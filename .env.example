# Copy this file to .env (or export these in your shell profile) and fill in
# real values locally. NEVER commit a file containing a real API key.

# Required: your Gemini API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional: use a higher-quality image model (default is gemini-2.5-flash-image)
# NANOBANANA_MODEL=gemini-3-pro-image-preview
